# Cluster credentials. Copy to `.env` (gitignored) and fill in real values, then
# `mise run secrets:sync` turns them into Kubernetes Secrets.
#
# These live only on your machine and inside the cluster. They are never committed
# and never rendered into a manifest — the charts read the Secrets by name. The one
# thing exposed to the internet is the Airflow web UI (Cloudflare tunnel), so the
# admin password below is the one that actually faces outward. Make it strong.
#
#   cp .env.example .env
#   $EDITOR .env
#   mise run secrets:sync        # or just run core:up / orchestration:up

# PostgreSQL application user password. The username is fixed to `app` (it matches
# the database owner CNPG creates and is not a secret), so only the password lives
# here. Used by Polaris, Airflow, and later MLflow / Superset / OpenMetadata.
POSTGRES_APP_PASSWORD=change-me-postgres

# MinIO root. Full access to the object store, including the console. Not exposed to
# the internet, but pick something real anyway.
MINIO_ROOT_USER=homelab-admin
MINIO_ROOT_PASSWORD=change-me-minio

# Airflow web UI admin. THIS ONE is reachable from the internet through the tunnel —
# make it long and unique.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow

# Airflow read-only account (Viewer role). Safe to share so people can see the demo:
# it can view DAGs, runs and logs but cannot trigger, edit or delete anything.
AIRFLOW_VIEWER_USERNAME=viewer
AIRFLOW_VIEWER_PASSWORD=change-me-viewer
